<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- "Obsidianite": violet-black glass with a cyan accent, after the Herdr terminal theme of the same name. -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <Color x:Key="BgColor">#0D0B12</Color>
    <SolidColorBrush x:Key="Bg" Color="#0D0B12"/>
    <SolidColorBrush x:Key="Surface" Color="#191621"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#14111B"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#221E2E"/>
    <SolidColorBrush x:Key="Stroke" Color="#26222F"/>
    <SolidColorBrush x:Key="StrokeStrong" Color="#383347"/>
    <SolidColorBrush x:Key="Text" Color="#CBD1DC"/>
    <SolidColorBrush x:Key="TextMuted" Color="#9A96AD"/>
    <SolidColorBrush x:Key="TextFaint" Color="#706B84"/>
    <SolidColorBrush x:Key="Accent" Color="#0FB6D6"/>
    <SolidColorBrush x:Key="AccentHover" Color="#45C8E2"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#0D232D"/>
    <SolidColorBrush x:Key="OnAccent" Color="#100E17"/>
    <SolidColorBrush x:Key="Scrim" Color="#AA05040A"/>
    <SolidColorBrush x:Key="ShadowNear" Color="#66000000"/>
    <SolidColorBrush x:Key="ShadowFar" Color="#33000000"/>
    <SolidColorBrush x:Key="LogoTile" Color="#EEEDF3"/>
    <SolidColorBrush x:Key="Selection" Color="#0FB6D6"/>

    <SolidColorBrush x:Key="Status.Operational" Color="#62EF75"/>
    <SolidColorBrush x:Key="Status.Operational.Soft" Color="#192B20"/>
    <SolidColorBrush x:Key="Status.Maintenance" Color="#7AA2F7"/>
    <SolidColorBrush x:Key="Status.Maintenance.Soft" Color="#1C2032"/>
    <SolidColorBrush x:Key="Status.Degraded" Color="#F1FA8C"/>
    <SolidColorBrush x:Key="Status.Degraded.Soft" Color="#2D2C23"/>
    <SolidColorBrush x:Key="Status.PartialOutage" Color="#FFB86C"/>
    <SolidColorBrush x:Key="Status.PartialOutage.Soft" Color="#2F231F"/>
    <SolidColorBrush x:Key="Status.MajorOutage" Color="#F4569D"/>
    <SolidColorBrush x:Key="Status.MajorOutage.Soft" Color="#2D1625"/>
    <SolidColorBrush x:Key="Status.Unknown" Color="#9A96AD"/>
    <SolidColorBrush x:Key="Status.Unknown.Soft" Color="#211E28"/>
</ResourceDictionary>
