<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- "Night ward": near-black green-tinted surfaces, phosphor-teal accent like a patient monitor. -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <Color x:Key="BgColor">#0A0F0E</Color>
    <SolidColorBrush x:Key="Bg" Color="#0A0F0E"/>
    <SolidColorBrush x:Key="Surface" Color="#121917"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#0E1412"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#16201D"/>
    <SolidColorBrush x:Key="Stroke" Color="#1F2A27"/>
    <SolidColorBrush x:Key="StrokeStrong" Color="#2E3B37"/>
    <SolidColorBrush x:Key="Text" Color="#E6EEEB"/>
    <SolidColorBrush x:Key="TextMuted" Color="#8E9F99"/>
    <SolidColorBrush x:Key="TextFaint" Color="#6B7B76"/>
    <SolidColorBrush x:Key="Accent" Color="#3DDBBE"/>
    <SolidColorBrush x:Key="AccentHover" Color="#6BE6CF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#12302A"/>
    <SolidColorBrush x:Key="OnAccent" Color="#03110E"/>
    <SolidColorBrush x:Key="Scrim" Color="#AA000000"/>
    <SolidColorBrush x:Key="ShadowNear" Color="#66000000"/>
    <SolidColorBrush x:Key="ShadowFar" Color="#33000000"/>
    <SolidColorBrush x:Key="LogoTile" Color="#F1F4F3"/>
    <SolidColorBrush x:Key="Selection" Color="#3DDBBE"/>

    <SolidColorBrush x:Key="Status.Operational" Color="#4ADE80"/>
    <SolidColorBrush x:Key="Status.Operational.Soft" Color="#11291B"/>
    <SolidColorBrush x:Key="Status.Maintenance" Color="#7AA7F7"/>
    <SolidColorBrush x:Key="Status.Maintenance.Soft" Color="#14213A"/>
    <SolidColorBrush x:Key="Status.Degraded" Color="#FBBF24"/>
    <SolidColorBrush x:Key="Status.Degraded.Soft" Color="#2E240D"/>
    <SolidColorBrush x:Key="Status.PartialOutage" Color="#FB923C"/>
    <SolidColorBrush x:Key="Status.PartialOutage.Soft" Color="#341E10"/>
    <SolidColorBrush x:Key="Status.MajorOutage" Color="#F87171"/>
    <SolidColorBrush x:Key="Status.MajorOutage.Soft" Color="#361718"/>
    <SolidColorBrush x:Key="Status.Unknown" Color="#8E9F99"/>
    <SolidColorBrush x:Key="Status.Unknown.Soft" Color="#1B2421"/>
</ResourceDictionary>
