<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- "Clinical daylight": cool paper neutrals with a monitor-teal accent. -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <Color x:Key="BgColor">#F2F4F3</Color>
    <SolidColorBrush x:Key="Bg" Color="#F2F4F3"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F6F8F7"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#FBFCFC"/>
    <SolidColorBrush x:Key="Stroke" Color="#E2E7E5"/>
    <SolidColorBrush x:Key="StrokeStrong" Color="#CBD3D0"/>
    <SolidColorBrush x:Key="Text" Color="#0F1715"/>
    <SolidColorBrush x:Key="TextMuted" Color="#5A6662"/>
    <SolidColorBrush x:Key="TextFaint" Color="#7E8985"/>
    <SolidColorBrush x:Key="Accent" Color="#0B8577"/>
    <SolidColorBrush x:Key="AccentHover" Color="#086D62"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E3F4F1"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Scrim" Color="#55101816"/>
    <!-- Logos are drawn on a light tile in both themes so dark logos stay visible -->
    <!-- Layered shadow (cards, status bar): two translucent rounded layers instead of a blur Effect -->
    <SolidColorBrush x:Key="ShadowNear" Color="#140F2A24"/>
    <SolidColorBrush x:Key="ShadowFar" Color="#0A0F2A24"/>
    <SolidColorBrush x:Key="LogoTile" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Selection" Color="#0B8577"/>

    <!-- Status colours: strong = text/icons (AA contrast on Surface), soft = tinted backgrounds -->
    <SolidColorBrush x:Key="Status.Operational" Color="#15803D"/>
    <SolidColorBrush x:Key="Status.Operational.Soft" Color="#E6F5EA"/>
    <SolidColorBrush x:Key="Status.Maintenance" Color="#1D5FD1"/>
    <SolidColorBrush x:Key="Status.Maintenance.Soft" Color="#E6EEFC"/>
    <SolidColorBrush x:Key="Status.Degraded" Color="#A15C00"/>
    <SolidColorBrush x:Key="Status.Degraded.Soft" Color="#FCF1D8"/>
    <SolidColorBrush x:Key="Status.PartialOutage" Color="#C2410C"/>
    <SolidColorBrush x:Key="Status.PartialOutage.Soft" Color="#FCE8DA"/>
    <SolidColorBrush x:Key="Status.MajorOutage" Color="#C81E1E"/>
    <SolidColorBrush x:Key="Status.MajorOutage.Soft" Color="#FBE3E3"/>
    <SolidColorBrush x:Key="Status.Unknown" Color="#5A6662"/>
    <SolidColorBrush x:Key="Status.Unknown.Soft" Color="#ECEFEE"/>
</ResourceDictionary>
