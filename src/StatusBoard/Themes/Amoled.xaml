<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- "AMOLED": true black everywhere (OLED pixels switch off), structure from thin outlines instead of grey panels,
         no shadows, slightly dimmed logo tiles to go easy on burn-in during long wall-board use. -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <Color x:Key="BgColor">#000000</Color>
    <SolidColorBrush x:Key="Bg" Color="#000000"/>
    <SolidColorBrush x:Key="Surface" Color="#000000"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#000000"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#0C0C0C"/>
    <SolidColorBrush x:Key="Stroke" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="StrokeStrong" Color="#333333"/>
    <SolidColorBrush x:Key="Text" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="TextMuted" Color="#9C9C9C"/>
    <SolidColorBrush x:Key="TextFaint" Color="#6E6E6E"/>
    <SolidColorBrush x:Key="Accent" Color="#2EE6C3"/>
    <SolidColorBrush x:Key="AccentHover" Color="#66F0D6"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#00231C"/>
    <SolidColorBrush x:Key="OnAccent" Color="#000000"/>
    <SolidColorBrush x:Key="Scrim" Color="#D9000000"/>
    <SolidColorBrush x:Key="ShadowNear" Color="#00000000"/>
    <SolidColorBrush x:Key="ShadowFar" Color="#00000000"/>
    <SolidColorBrush x:Key="LogoTile" Color="#DCDCDC"/>
    <SolidColorBrush x:Key="Selection" Color="#2EE6C3"/>

    <SolidColorBrush x:Key="Status.Operational" Color="#3EE77F"/>
    <SolidColorBrush x:Key="Status.Operational.Soft" Color="#06200F"/>
    <SolidColorBrush x:Key="Status.Maintenance" Color="#6EA8FF"/>
    <SolidColorBrush x:Key="Status.Maintenance.Soft" Color="#081A36"/>
    <SolidColorBrush x:Key="Status.Degraded" Color="#FFC83D"/>
    <SolidColorBrush x:Key="Status.Degraded.Soft" Color="#2A1F00"/>
    <SolidColorBrush x:Key="Status.PartialOutage" Color="#FF9640"/>
    <SolidColorBrush x:Key="Status.PartialOutage.Soft" Color="#2E1500"/>
    <SolidColorBrush x:Key="Status.MajorOutage" Color="#FF5A5A"/>
    <SolidColorBrush x:Key="Status.MajorOutage.Soft" Color="#330707"/>
    <SolidColorBrush x:Key="Status.Unknown" Color="#9C9C9C"/>
    <SolidColorBrush x:Key="Status.Unknown.Soft" Color="#141414"/>
</ResourceDictionary>
