<UserControl x:Class="StatusBoard.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StatusBoard.ViewModels">
    <!-- Settings drawer content. DataContext: SettingsViewModel. Vendors are chosen in the Vendors pane. -->
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="24,20,16,8">
            <TextBlock Text="Settings" FontFamily="{DynamicResource DisplayFont}" FontSize="20" FontWeight="SemiBold"/>
            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Command="{Binding CancelCommand}" ToolTip="Close"
                    AutomationProperties.Name="Close settings" Foreground="{DynamicResource TextMuted}" Padding="6">
                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
            </Button>
        </Grid>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel>
                <TextBlock Style="{StaticResource Muted}"><Run Text="Saved to "/><Run Text="{Binding ConfigPath, Mode=OneWay}"/></TextBlock>
                <Button Style="{StaticResource LinkButton}" Content="Show in folder" FontSize="12" Margin="0,4,0,12" Command="{Binding OpenConfigFolderCommand}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SubtleButton}" Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" MinWidth="88"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Save" Command="{Binding SaveCommand}" MinWidth="88"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,24,16">
            <StackPanel>
                <!-- Profiles: each its own board (vendors, groups, theme). Changes here apply immediately. -->
                <DockPanel Margin="0,4,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Padding="10,5" VerticalAlignment="Center"
                            Command="{Binding DataContext.NewProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,2,6,0"/>
                            <TextBlock Text="New profile"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="PROFILES" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
                </DockPanel>
                <Border CornerRadius="10" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Padding="12,8">
                    <ItemsControl x:Name="ProfileList" ItemsSource="{Binding DataContext.ProfileRows, RelativeSource={RelativeSource AncestorType=Window}}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProfileRowViewModel}">
                                <DockPanel Margin="0,4">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Command="{Binding DeleteCommand}" Padding="6,4" Margin="6,0,0,0"
                                            Foreground="{DynamicResource Status.MajorOutage}" ToolTip="Delete this profile and its settings"
                                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="{Binding Name, StringFormat='Delete profile {0}'}">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                    </Button>
                                    <Grid DockPanel.Dock="Right" Width="84" Margin="8,0,0,0">
                                        <Border CornerRadius="9" Background="{DynamicResource AccentSoft}" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="In use" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                        </Border>
                                        <Button Style="{StaticResource SubtleButton}" Content="Switch" Command="{Binding SwitchCommand}" Padding="10,4"
                                                Visibility="{Binding IsActive, Converter={StaticResource InvBoolToVis}}" AutomationProperties.Name="{Binding Name, StringFormat='Switch to {0}'}"/>
                                    </Grid>
                                    <TextBox Text="{Binding Name}" MaxLength="40" AutomationProperties.Name="Profile name" ToolTip="{Binding FileName, StringFormat='Settings file: {0}'}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Each profile is its own board: vendors, groups and theme. Switch quickly from the top-left corner."/>

                <TextBlock Text="GENERAL" Style="{StaticResource SectionLabel}" Margin="0,22,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                    <ComboBox x:Name="RefreshBox" Grid.Column="1" ItemsSource="{Binding RefreshOptions}" DisplayMemberPath="Label" SelectedValuePath="Minutes"
                              SelectedValue="{Binding RefreshIntervalMinutes}" MinWidth="160" HorizontalAlignment="Left" AutomationProperties.Name="Refresh interval"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Muted}" Margin="0,6,0,0"
                               Text="Refreshes run automatically at this interval. Choose Manual to refresh only with the button or F5."/>
                    <TextBlock Grid.Row="2" Text="Theme" VerticalAlignment="Center" Margin="0,12,0,0"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" MinWidth="160"
                              HorizontalAlignment="Left" Margin="0,12,0,0" AutomationProperties.Name="Theme"/>
                </Grid>

                <CheckBox IsChecked="{Binding TrayIcon}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Show icon in the notification area"/>
                        <TextBlock Text="Coloured by overall status. Minimising hides the window to the tray." Style="{StaticResource Muted}"/>
                    </StackPanel>
                </CheckBox>
                <CheckBox IsChecked="{Binding NewsTicker}" Margin="0,10,0,0" AutomationProperties.Name="Scrolling news ticker">
                    <StackPanel>
                        <TextBlock Text="Scrolling news ticker"/>
                        <TextBlock Text="Runs along the bottom of the status bar with the latest update on each active incident. Hover to pause, click to open." Style="{StaticResource Muted}"/>
                    </StackPanel>
                </CheckBox>
                <!-- Year progress: the header clock steps aside now and then (it also keeps the one fixed element on a wall screen moving) -->
                <CheckBox x:Name="YearProgressCheck" IsChecked="{Binding YearProgressCycle}" Margin="0,10,0,0" AutomationProperties.Name="Show year progress in place of the clock">
                    <StackPanel>
                        <TextBlock Text="Show year progress in place of the clock"/>
                        <TextBlock Text="Every so often the clock steps aside for 15 seconds to show how far through the year we are." Style="{StaticResource Muted}"/>
                    </StackPanel>
                </CheckBox>
                <ComboBox x:Name="YearProgressBox" ItemsSource="{Binding YearProgressOptions}" DisplayMemberPath="Label" SelectedValuePath="Minutes"
                          SelectedValue="{Binding YearProgressIntervalMinutes}" MinWidth="160" HorizontalAlignment="Left" Margin="28,8,0,0"
                          IsEnabled="{Binding YearProgressCycle}" AutomationProperties.Name="How often to show year progress"/>

                <!-- Vendor logos: pick a vendor, upload an image; it's trimmed and centred on a white tile like the built-in logos -->
                <TextBlock Text="VENDOR LOGOS" Style="{StaticResource SectionLabel}" Margin="0,26,0,4"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                           Text="Give any vendor your own logo. Upload a PNG or JPG: empty space is trimmed and the logo is centred on a white tile to match the others."/>
                <Border Padding="16" CornerRadius="10" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <!-- Large preview, drawn exactly like a tile logo -->
                        <Grid Width="76" Height="76" VerticalAlignment="Top" Margin="0,0,16,0" DataContext="{Binding LogoVendor}">
                            <Border CornerRadius="16" Background="{DynamicResource LogoTile}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Padding="9"
                                    Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}}">
                                <Image Source="{Binding Logo}" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Logo preview"/>
                            </Border>
                            <Border CornerRadius="16" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Padding="10"
                                    Visibility="{Binding HasLogo, Converter={StaticResource InvBoolToVis}}">
                                <Viewbox StretchDirection="DownOnly"><TextBlock Text="{Binding Monogram}" FontWeight="Bold" FontSize="22" Foreground="{DynamicResource TextMuted}"/></Viewbox>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Vendor" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="LogoVendorBox" ItemsSource="{Binding LogoVendors}" SelectedItem="{Binding LogoVendor}" AutomationProperties.Name="Vendor to change the logo of"
                                      VirtualizingPanel.IsVirtualizing="True" MaxDropDownHeight="360">
                                <ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LogoChoiceViewModel}">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource VendorBadgeSmall}" Margin="0,0,8,0" Width="20" Height="20"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding UploadLogoCommand}" Padding="12,6" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,2,7,0"/>
                                        <TextBlock Text="Upload logo…"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SubtleButton}" Content="Use automatic logo" Command="{Binding ResetLogoCommand}" Padding="12,6" Margin="0,0,0,6"
                                        ToolTip="Remove the uploaded logo and go back to the one found on the vendor's website"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding LogoMessage}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                                       Visibility="{Binding HasLogoMessage, Converter={StaticResource BoolToVis}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Status.Operational}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding LogoMessageIsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Status.Degraded}"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="Uploaded logos are kept in “logos\custom” next to the app. Other logos are fetched from each vendor's website."/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
