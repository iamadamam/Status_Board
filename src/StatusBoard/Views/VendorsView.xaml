<UserControl x:Class="StatusBoard.Views.VendorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StatusBoard.ViewModels"
             xmlns:v="clr-namespace:StatusBoard.Views">
    <!-- Vendors drawer. DataContext: VendorsViewModel. Each row expands to show what it watches and a link to its status page. -->
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="24,20,16,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Vendors" FontFamily="{DynamicResource DisplayFont}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding WatchedSummary}" Style="{StaticResource Muted}" FontSize="12.5" Margin="12,4,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Command="{Binding CancelCommand}" ToolTip="Close"
                    AutomationProperties.Name="Close vendors" Foreground="{DynamicResource TextMuted}" Padding="6">
                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
            </Button>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="24,0,24,12"
                   Text="Tick the vendors to show on the board. Click a vendor to see what it covers and open its status page."/>

        <!-- Search and filters -->
        <StackPanel DockPanel.Dock="Top" Margin="24,0,24,10">
            <DockPanel>
                <!-- Back to the default selection of built-in vendors (your own vendors stay as they are); Save to apply -->
                <Button x:Name="DefaultSelectionButton" DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Padding="12,6" Margin="8,0,0,0" Command="{Binding DefaultSelectionCommand}"
                        Content="Default" ToolTip="Watch the default 60 vendors (your own vendors are left as they are). Save to apply." AutomationProperties.Name="Default selection"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Padding="12,6" Margin="8,0,0,0" Command="{Binding ShowAddVendorCommand}"
                        Visibility="{Binding IsAddingVendor, Converter={StaticResource InvBoolToVis}}" AutomationProperties.Name="Add vendor">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,2,6,0"/>
                        <TextBlock Text="Add vendor"/>
                    </StackPanel>
                </Button>
                <Grid>
                    <TextBox x:Name="VendorSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,6,8,6" AutomationProperties.Name="Search vendors"/>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock Text="Search vendors or services…" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="33,0,0,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding ShowOptions}" SelectedItem="{Binding ShowFilter}" AutomationProperties.Name="Show"/>
                <ComboBox Grid.Column="2" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding CategoryFilter}" AutomationProperties.Name="Category"/>
            </Grid>

            <!-- Board groups: optional sections shown above the other vendors, in this order -->
            <Border Margin="0,10,0,0" Padding="12,8" CornerRadius="10" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" FontSize="12" Command="{Binding ToggleGroupsCommand}" VerticalAlignment="Center">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Manage groups"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsManagingGroups}" Value="True"><Setter Property="Text" Value="Done"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                        <TextBlock VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis">
                            <Run Text="Board groups" FontWeight="SemiBold"/><Run Text="  ·  " Foreground="{DynamicResource TextFaint}"/><Run Text="{Binding GroupsSummary, Mode=OneWay}" Foreground="{DynamicResource TextMuted}"/>
                        </TextBlock>
                    </DockPanel>
                    <StackPanel Margin="0,10,0,2" Visibility="{Binding IsManagingGroups, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                                   Text="Groups appear as sections at the top of the board, in this order. Put a vendor in a group from its details below."/>
                        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GroupEditViewModel}">
                                    <DockPanel Margin="0,0,0,6">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                                            <Button Style="{StaticResource LinkButton}" Command="{Binding MoveUpCommand}" Padding="6,4" Foreground="{DynamicResource TextMuted}" ToolTip="Move up"
                                                    AutomationProperties.Name="{Binding Name, StringFormat='Move {0} up'}"><TextBlock Text="&#xE70E;" FontFamily="{StaticResource IconFont}" FontSize="11"/></Button>
                                            <Button Style="{StaticResource LinkButton}" Command="{Binding MoveDownCommand}" Padding="6,4" Foreground="{DynamicResource TextMuted}" ToolTip="Move down"
                                                    AutomationProperties.Name="{Binding Name, StringFormat='Move {0} down'}"><TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="11"/></Button>
                                            <Button Style="{StaticResource LinkButton}" Command="{Binding DeleteCommand}" Padding="6,4" Foreground="{DynamicResource Status.MajorOutage}" ToolTip="Delete group (its vendors become ungrouped)"
                                                    AutomationProperties.Name="{Binding Name, StringFormat='Delete group {0}'}"><TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12"/></Button>
                                        </StackPanel>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Group name" MaxLength="60"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Command="{Binding AddGroupCommand}" Padding="10,5" Margin="8,0,0,0" Content="Add group"/>
                            <Grid>
                                <TextBox x:Name="NewGroupBox" Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New group name" MaxLength="60">
                                    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddGroupCommand}"/></TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Text="New group, e.g. Critical" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding NewGroupName}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel>
                <!-- Bulk actions apply to the vendors currently shown (after search and filters) -->
                <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Style="{StaticResource LinkButton}" Content="Watch all shown" FontSize="12" Command="{Binding WatchShownCommand}" Margin="0,2,14,2"/>
                    <Button Style="{StaticResource LinkButton}" Content="Watch none" FontSize="12" Command="{Binding UnwatchShownCommand}" Margin="0,2,14,2" ToolTip="Stop watching all vendors shown"/>
                    <Button Style="{StaticResource LinkButton}" Content="Collapse all" FontSize="12" Command="{Binding CollapseAllCommand}" Margin="0,2,0,2"/>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SubtleButton}" Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" MinWidth="88"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Save" Command="{Binding SaveCommand}" MinWidth="88"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="ListScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,24,16" Focusable="False">
            <StackPanel>
                <!-- Add a vendor -->
                <Border Margin="0,0,0,12" Padding="16,14" CornerRadius="10" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                        Visibility="{Binding IsAddingVendor, Converter={StaticResource BoolToVis}}">
                    <StackPanel x:Name="AddVendorForm" DataContext="{Binding AddVendor}">
                        <TextBlock Text="Add a vendor" FontWeight="SemiBold" FontSize="14"/>
                        <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Margin="0,10,0,0" HorizontalAlignment="Left" MinWidth="200" AutomationProperties.Name="Kind of source"/>
                        <TextBlock Text="Address" Margin="0,12,0,4"/>
                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Address"/>
                        <TextBlock Text="{Binding UrlHint}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>

                        <StackPanel Visibility="{Binding IsLibreNms, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="API token" Margin="0,12,0,4"/>
                            <PasswordBox x:Name="TokenBox" PasswordChanged="Token_PasswordChanged" AutomationProperties.Name="API token"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Create one in LibreNMS under Settings › API. Stored encrypted for your Windows user."/>
                            <CheckBox IsChecked="{Binding AllowInvalidCertificate}" Margin="0,10,0,0" Content="Allow self-signed certificate (this server only)"/>
                            <CheckBox IsChecked="{Binding IncludeAcknowledged}" Margin="0,6,0,0" Content="Also show acknowledged alerts"/>
                        </StackPanel>

                        <!-- Website / ping check options -->
                        <Grid Margin="0,12,0,0" Visibility="{Binding IsCheck, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Slow if over" VerticalAlignment="Center" Margin="0,0,10,6"/>
                            <TextBox Grid.Column="1" Text="{Binding SlowMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" AutomationProperties.Name="Slow if over, milliseconds"/>
                            <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,6"/>
                            <TextBlock Grid.Row="1" Text="Down after" VerticalAlignment="Center" Margin="0,0,10,6"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FailuresBeforeDown, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" AutomationProperties.Name="Down after this many failed checks"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="failed checks in a row" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,6"/>
                            <TextBlock Grid.Row="2" Text="Expected codes" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="{Binding IsWebsite, Converter={StaticResource BoolToVis}}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ExpectedCodes, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsWebsite, Converter={StaticResource BoolToVis}}"
                                     AutomationProperties.Name="Expected HTTP status codes"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="e.g. 200-399 or 200,401" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Visibility="{Binding IsWebsite, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Visibility="{Binding IsCheck, Converter={StaticResource BoolToVis}}"
                                   Text="Checked every minute from this PC. Marked down only after several failures in a row, so a brief blip isn't an alert."/>

                        <Button Style="{StaticResource SubtleButton}" Command="{Binding CheckCommand}" Padding="12,6" Margin="0,12,0,0" HorizontalAlignment="Left">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding CheckButtonText}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsChecking}" Value="True"><Setter Property="Text" Value="Checking…"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding CheckSucceeded}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Status.Operational}"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Margin="0,10,0,0" Visibility="{Binding IsFeed, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="How should feed items be read?" Margin="0,0,0,4"/>
                            <RadioButton IsChecked="{Binding FeedEveryItemActive, Converter={StaticResource InvBool}}" GroupName="feedmode" Margin="0,2">
                                <TextBlock Text="Only items from the last 24 hours are current (most feeds)" TextWrapping="Wrap"/>
                            </RadioButton>
                            <RadioButton IsChecked="{Binding FeedEveryItemActive}" GroupName="feedmode" Margin="0,2">
                                <TextBlock Text="Every item is a current issue (feed is empty when all is well)" TextWrapping="Wrap"/>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Visibility="{Binding CheckSucceeded, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Display name" Margin="0,12,0,4"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Display name"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Tip: give it your own logo afterwards in Settings › Vendor logos."/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Style="{StaticResource SubtleButton}" Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" Padding="12,6"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Add" Command="{Binding AddCommand}" Padding="16,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="No vendors match. Try another search, or add your own with “Add vendor”." Style="{StaticResource Muted}" Margin="2,8"
                           Visibility="{Binding NothingShown, Converter={StaticResource BoolToVis}}"/>

                <!-- The list -->
                <ItemsControl x:Name="VendorList" ItemsSource="{Binding VendorsView}" Focusable="False">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2,10,2,6">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:VendorSettingsViewModel}">
                            <Border x:Name="Row" Margin="0,0,0,8" CornerRadius="12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <!-- Whole row (except the watch box) toggles the details -->
                                        <Button Style="{StaticResource CardButton}" Command="{Binding ToggleExpandedCommand}" Margin="1"
                                                AutomationProperties.Name="{Binding Name, StringFormat='{}{0} – show details'}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource VendorBadge}" Margin="0,-6,12,-6" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" FontFamily="{DynamicResource DisplayFont}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding RowSummary}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding ExpandGlyph}" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Button>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="4,0,16,0" MinHeight="0"
                                                  AutomationProperties.Name="{Binding Name, StringFormat='Watch {0}'}" ToolTip="Show this vendor on the board">
                                            <TextBlock Text="Watch" FontSize="12.5"/>
                                        </CheckBox>
                                    </Grid>

                                    <!-- Details -->
                                    <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="18,12,18,14"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <TextBlock Text="Status page" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                                                <TextBlock Grid.Column="1" Text="{Binding StatusPageUrl, TargetNullValue='Not set'}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" ToolTip="{Binding StatusPageUrl}"/>
                                                <TextBlock Grid.Row="1" Text="Category" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Category}" FontSize="12.5" Margin="0,0,0,6"/>
                                                <TextBlock Grid.Row="2" Text="Read from" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SourceType}" FontSize="12.5" Margin="0,0,0,6"/>
                                                <TextBlock Grid.Row="3" Text="Watching" Style="{StaticResource Muted}"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WatchesText}" FontSize="12.5"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,6,0,0" Visibility="{Binding Subtitle, Converter={StaticResource NullToCollapsed}}"/>

                                            <!-- Group -->
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Board group" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding GroupChoices}" SelectedItem="{Binding Group}" DisplayMemberPath="Name"
                                                          HorizontalAlignment="Left" MinWidth="200" AutomationProperties.Name="Board group"/>
                                            </Grid>

                                            <WrapPanel Margin="0,12,0,0">
                                                <Button Style="{StaticResource SubtleButton}" Command="{Binding OpenStatusPageCommand}" Padding="12,6" Margin="0,0,8,0" ToolTip="{Binding StatusPageUrl}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Open status page"/>
                                                        <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="8,2,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource SubtleButton}" Command="{Binding RemoveCommand}" Padding="12,6" Foreground="{DynamicResource Status.MajorOutage}"
                                                        Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}" Content="Remove vendor"/>
                                            </WrapPanel>

                                            <!-- Salesforce instances -->
                                            <StackPanel Margin="0,14,0,0" Visibility="{Binding HasInstances, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="YOUR INSTANCES (BLANK = ALL)" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Instances, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Salesforce instances"/>
                                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="{Binding InstancesHint}"/>
                                            </StackPanel>

                                            <!-- Components: only the ones we use -->
                                            <StackPanel Margin="0,14,0,0" Visibility="{Binding CanFilterComponents, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="COMPONENTS" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                                                <RadioButton IsChecked="{Binding FilterComponents, Converter={StaticResource InvBool}}" Margin="0,2" GroupName="{Binding Config.Id, StringFormat='comp-{0}'}">
                                                    <TextBlock Text="All components count" TextWrapping="Wrap"/>
                                                </RadioButton>
                                                <RadioButton IsChecked="{Binding FilterComponents}" Margin="0,2" GroupName="{Binding Config.Id, StringFormat='comp-{0}'}">
                                                    <TextBlock TextWrapping="Wrap" Text="Only the components I choose – outages elsewhere won't change this vendor's status"/>
                                                </RadioButton>
                                                <StackPanel Margin="24,6,0,0" Visibility="{Binding FilterComponents, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding ComponentsMessage}" Style="{StaticResource Muted}" Margin="0,0,0,6"
                                                               Visibility="{Binding ComponentsMessage, Converter={StaticResource NullToCollapsed}}"/>
                                                    <Button Style="{StaticResource SubtleButton}" Content="Load components" Command="{Binding LoadComponentsCommand}" Padding="10,5" HorizontalAlignment="Left"
                                                            Visibility="{Binding ShowComponentPicker, Converter={StaticResource InvBoolToVis}}"/>
                                                    <ItemsControl ItemsSource="{Binding ComponentSources}" Focusable="False" Visibility="{Binding ShowComponentPicker, Converter={StaticResource BoolToVis}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:SourceComponentsViewModel}">
                                                                <StackPanel Margin="0,0,0,10">
                                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding SelectedText}" Style="{StaticResource Muted}" Margin="0,1,0,4"
                                                                               Visibility="{Binding HasComponents, Converter={StaticResource BoolToVis}}"/>
                                                                    <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}"/>
                                                                    <StackPanel Visibility="{Binding HasComponents, Converter={StaticResource BoolToVis}}">
                                                                        <DockPanel Margin="0,0,0,6">
                                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                                <Button Style="{StaticResource LinkButton}" Content="Tick shown" FontSize="12" Command="{Binding SelectShownCommand}"/>
                                                                                <Button Style="{StaticResource LinkButton}" Content="Clear" FontSize="12" Margin="10,0,0,0" Command="{Binding ClearCommand}"/>
                                                                            </StackPanel>
                                                                            <Grid>
                                                                                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" AutomationProperties.Name="Search components"/>
                                                                                <TextBlock Text="Search components…" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            <Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                            </Grid>
                                                                        </DockPanel>
                                                                        <ItemsControl ItemsSource="{Binding Shown}" Focusable="False">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate DataType="{x:Type vm:ComponentChoiceViewModel}">
                                                                                    <DockPanel Margin="0,0,0,3">
                                                                                        <v:StatusIndicator DockPanel.Dock="Right" Style="{StaticResource StatusIcon}" Status="{Binding Status}" FontSize="12" Margin="8,0,0,0"/>
                                                                                        <CheckBox IsChecked="{Binding Selected}" MinHeight="0"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></CheckBox>
                                                                                    </DockPanel>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        <TextBlock Text="{Binding MoreText}" Style="{StaticResource Muted}" Visibility="{Binding MoreText, Converter={StaticResource NullToCollapsed}}"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                                                               Text="Incidents that don't say which components they affect still count."/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Products / feeds / regions -->
                                            <StackPanel Margin="0,14,0,0" Visibility="{Binding HasPicker, Converter={StaticResource BoolToVis}}">
                                                <DockPanel Margin="0,0,0,6">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Style="{StaticResource LinkButton}" Content="Select all" FontSize="12" Command="{Binding SelectAllCommand}"/>
                                                        <Button Style="{StaticResource LinkButton}" Content="None" FontSize="12" Margin="12,0,0,0" Command="{Binding SelectNoneCommand}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding PickerTitle}" Style="{StaticResource SectionLabel}" Margin="0"/>
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding Sources}" Focusable="False">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate><DataTemplate>
                                                        <CheckBox IsChecked="{Binding Enabled}" Margin="0,0,8,4" ToolTip="{Binding Url}"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></CheckBox>
                                                    </DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding Regions}" Focusable="False">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate><DataTemplate>
                                                        <CheckBox IsChecked="{Binding Selected}" Margin="0,0,8,4"><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/></CheckBox>
                                                    </DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Enabled}" Value="True">
                                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource StrokeStrong}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
