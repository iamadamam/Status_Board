<UserControl x:Class="StatusBoard.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StatusBoard.ViewModels">
    <!-- First-time setup / New profile. DataContext: SetupViewModel. -->
    <DockPanel>
        <!-- Title, intro and the four steps -->
        <StackPanel DockPanel.Dock="Top" Margin="32,28,32,12">
            <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource DisplayFont}" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Intro}" Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0"/>
            <ItemsControl x:Name="StepBar" Margin="0,18,0,0" Focusable="False" ItemsSource="{Binding StepItems}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SetupViewModel+StepItem}">
                        <StackPanel Margin="0,0,8,0">
                            <Border x:Name="Bar" Height="4" CornerRadius="2" Background="{DynamicResource Stroke}"/>
                            <TextBlock x:Name="Lbl" Text="{Binding Name}" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <!-- Steps up to the current one light up; the current one is bold -->
                            <DataTrigger Binding="{Binding Reached}" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource Text}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Current}" Value="True"><Setter TargetName="Lbl" Property="FontWeight" Value="SemiBold"/></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Buttons -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="32,14">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Content="Cancel" Command="{Binding CancelCommand}" VerticalAlignment="Center"
                        Visibility="{Binding IsFirstRun, Converter={StaticResource InvBoolToVis}}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SubtleButton}" Content="Back" Command="{Binding BackCommand}" Margin="0,0,8,0" MinWidth="88"
                            Visibility="{Binding IsNameStep, Converter={StaticResource InvBoolToVis}}"/>
                    <Button x:Name="NextButton" Style="{StaticResource PrimaryButton}" Content="{Binding NextText}" Command="{Binding NextCommand}" MinWidth="104" IsDefault="True"
                            Visibility="{Binding IsDoneStep, Converter={StaticResource InvBoolToVis}}"/>
                    <Button x:Name="FinishButton" Style="{StaticResource PrimaryButton}" Content="Finish" Command="{Binding FinishCommand}" MinWidth="104"
                            Visibility="{Binding IsDoneStep, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Status.Degraded}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0"
                           Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}"/>
            </DockPanel>
        </Border>

        <Grid Margin="32,8,32,16">
            <!-- 1. Name -->
            <StackPanel Visibility="{Binding IsNameStep, Converter={StaticResource BoolToVis}}" MaxWidth="460" HorizontalAlignment="Left">
                <TextBlock Text="What should this profile be called?" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Your name, a team or a screen – e.g. “Service desk” or “Office TV”." Style="{StaticResource Muted}" Margin="0,4,0,12"/>
                <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="10,8" MaxLength="40" AutomationProperties.Name="Profile name"/>
            </StackPanel>

            <!-- 2. Vendors -->
            <DockPanel Visibility="{Binding IsVendorsStep, Converter={StaticResource BoolToVis}}">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Which vendors do you rely on?" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12"
                               Text="Tick the ones to show on your board. You can fine-tune products, regions and components later in Vendors."/>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button x:Name="DefaultButton" Style="{StaticResource SubtleButton}" Content="Default" Command="{Binding SelectPopularCommand}" Padding="12,6" Margin="0,0,8,0"
                                    ToolTip="Tick the default 60: the most widely used cloud, Microsoft, security, IT and business vendors"/>
                            <Button Style="{StaticResource LinkButton}" Content="Clear" Command="{Binding ClearCommand}"/>
                        </StackPanel>
                        <Grid>
                            <TextBox x:Name="SetupSearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="30,6,8,6" AutomationProperties.Name="Search vendors"/>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock Text="Search vendors…" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="33,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                    <TextBlock Text="{Binding SelectedSummary}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                </StackPanel>
                <!-- Virtualised: logos load only for rows on screen -->
                <ListBox x:Name="SetupList" ItemsSource="{Binding VendorsView}" BorderThickness="1" BorderBrush="{DynamicResource Stroke}" Background="{DynamicResource SurfaceAlt}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Vendors">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionLabel}" Margin="12,12,0,4"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SetupVendorViewModel}">
                            <CheckBox IsChecked="{Binding Selected}" Margin="12,3" AutomationProperties.Name="{Binding Name}">
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource VendorBadgeSmall}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- 3. Theme -->
            <StackPanel Visibility="{Binding IsThemeStep, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Pick a look" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="It changes as you choose, so you can see it. AMOLED and Hacker suit wall screens and OLED TVs." Style="{StaticResource Muted}" Margin="0,4,0,14"/>
                <ItemsControl ItemsSource="{Binding Themes}" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ThemeChoice}">
                            <Button Style="{StaticResource CardButton}" Width="196" Margin="0,0,12,12" Command="{Binding DataContext.PickThemeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} theme'}">
                                <Grid>
                                    <Border x:Name="Ring" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource Stroke}" Margin="-14,-12,-12,-12"/>
                                    <StackPanel>
                                        <!-- mini board -->
                                        <Border Height="74" CornerRadius="8" Background="{Binding SwatchBg}" BorderBrush="{Binding SwatchStroke}" BorderThickness="1" Padding="8">
                                            <StackPanel>
                                                <TextBlock Text="12:00" Foreground="{Binding SwatchText}" FontFamily="{Binding SwatchFont}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <UniformGrid Columns="3" Margin="0,6,0,0">
                                                    <Border Height="28" Margin="2" CornerRadius="4" Background="{Binding SwatchPanel}" BorderBrush="{Binding SwatchStroke}" BorderThickness="1">
                                                        <Ellipse Width="6" Height="6" Fill="{Binding SwatchAccent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"/>
                                                    </Border>
                                                    <Border Height="28" Margin="2" CornerRadius="4" Background="{Binding SwatchPanel}" BorderBrush="{Binding SwatchStroke}" BorderThickness="1">
                                                        <Ellipse Width="6" Height="6" Fill="#F87171" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"/>
                                                    </Border>
                                                    <Border Height="28" Margin="2" CornerRadius="4" Background="{Binding SwatchPanel}" BorderBrush="{Binding SwatchStroke}" BorderThickness="1">
                                                        <Ellipse Width="6" Height="6" Fill="{Binding SwatchAccent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"/>
                                                    </Border>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Accent}"/></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 4. Done -->
            <StackPanel Visibility="{Binding IsDoneStep, Converter={StaticResource BoolToVis}}" MaxWidth="520" HorizontalAlignment="Left">
                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="34" Foreground="{DynamicResource Status.Operational}"/>
                <TextBlock Text="All set" FontFamily="{DynamicResource DisplayFont}" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding Summary}" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,0" FontSize="12.5"
                           Text="Press Finish to start checking. Later: Vendors (top right) to add or tune vendors, Settings for logos, refresh and theme, and the profile button (top left) to switch or add profiles."/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
