<Window x:Class="StatusBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:StatusBoard.Views"
        Title="Status Board" Icon="Assets/app.ico" Width="1180" Height="780" MinWidth="380" MinHeight="420" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="{DynamicResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ZoomResetCommand}"/>
        <KeyBinding Key="NumPad0" Modifiers="Control" Command="{Binding ZoomResetCommand}"/>
        <KeyBinding Key="F11" Command="{Binding ToggleTvCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- Header -->
        <!-- Header: profile on the left, today's date and time centred, controls on the right. Equal outer columns keep the clock truly
             centred; it hides itself on windows too narrow to fit it beside the controls (MainWindow.FitClock). -->
        <Grid x:Name="HeaderGrid" Margin="24,12,24,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <!-- Row 1 is used only when the clock can't sit between the profile button and the controls: it then gets row 0 to itself -->
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Button x:Name="ProfileButton" Grid.ColumnSpan="3" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource SubtleButton}" Padding="10,6"
                    Click="ProfileButton_Click" ToolTip="Switch profile" AutomationProperties.Name="{Binding ProfileName, StringFormat='Profile: {0}. Switch profile'}"
                    Visibility="{Binding IsTvMode, Converter={StaticResource InvBoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,1,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ProfileName}" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="8,2,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
            </Button>
            <StackPanel x:Name="ClockPanel" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding ClockSpoken}">
                <TextBlock x:Name="ClockTime" Text="{Binding ClockText}" FontFamily="{DynamicResource DisplayFont}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Typography.NumeralAlignment="Tabular" Margin="0,-4,0,-2"/>
                <TextBlock x:Name="ClockDate" Text="{Binding DateText}" FontSize="13" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
            </StackPanel>
            <DockPanel x:Name="HeaderControls" Grid.ColumnSpan="3" LastChildFill="False" HorizontalAlignment="Right">
            <!-- TV mode: a quiet way out instead of the controls -->
            <!-- Fades out after 10 s without mouse movement; any move or key brings it back (MainWindow.ShowTvControls) -->
            <StackPanel x:Name="TvControls" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsTvMode, Converter={StaticResource BoolToVis}}">
                <!-- Auto-scroll on/off (also S); lit when on -->
                <ToggleButton x:Name="TvScrollToggle" IsChecked="{Binding TvAutoScroll}" Margin="0,0,8,0" Padding="10,6" Opacity="0.85" Cursor="Hand"
                              ToolTip="Scroll the board automatically (S)" AutomationProperties.Name="{Binding TvScrollText}" FocusVisualStyle="{StaticResource FocusRing}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource Stroke}" Background="{DynamicResource Surface}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8CB;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TvScrollText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="ExitTvButton" Style="{StaticResource SubtleButton}" Command="{Binding ToggleTvCommand}" Padding="10,6" Opacity="0.75" ToolTip="Leave TV mode (Esc or F11)"
                        AutomationProperties.Name="Exit TV mode">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73F;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,8,0"/>
                        <TextBlock Text="Exit TV mode"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsTvMode, Converter={StaticResource InvBoolToVis}}">
                <!-- Tiles | List -->
                <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="7" Background="{DynamicResource Surface}" Margin="0,0,8,0" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TilesToggle" Style="{StaticResource SegmentButton}" GroupName="boardview" IsChecked="{Binding IsListView, Converter={StaticResource InvBool}}"
                                     ToolTip="Tiles" AutomationProperties.Name="Show as tiles">
                            <TextBlock Text="&#xF0E2;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                        </RadioButton>
                        <RadioButton x:Name="ListToggle" Style="{StaticResource SegmentButton}" GroupName="boardview" IsChecked="{Binding IsListView}"
                                     ToolTip="List" AutomationProperties.Name="Show as a list">
                            <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <Button x:Name="TvButton" Style="{StaticResource SubtleButton}" Command="{Binding ToggleTvCommand}" Margin="0,0,8,0" Padding="10,7"
                        ToolTip="TV mode: full screen, large tiles, auto-scrolling (F11)" AutomationProperties.Name="TV mode">
                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="15"/>
                </Button>
                <Button x:Name="VendorsButton" Style="{StaticResource SubtleButton}" Command="{Binding OpenVendorsCommand}" Margin="0,0,8,0" Padding="12,7,8,7"
                        ToolTip="Browse vendors, choose which to watch and open their status pages" AutomationProperties.Name="Vendors">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,1,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Vendors" VerticalAlignment="Center"/>
                        <!-- How many are on the board -->
                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="9" Padding="7,1,7,2" Margin="8,0,0,0" MinWidth="22" VerticalAlignment="Center"
                                ToolTip="Vendors on the board">
                            <TextBlock Text="{Binding WatchingCount}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Button>
                <!-- Tile size: − 100% + (also Ctrl+wheel, Ctrl +/−, Ctrl 0) -->
                <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="7" Background="{DynamicResource Surface}" Margin="0,0,8,0"
                        ToolTip="Tile size (Ctrl + mouse wheel, Ctrl + / Ctrl −, Ctrl 0 to reset)">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource LinkButton}" Command="{Binding ZoomOutCommand}" Padding="10,7" Foreground="{DynamicResource Text}" AutomationProperties.Name="Smaller tiles">
                            <TextBlock Text="&#xE738;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource LinkButton}" Command="{Binding ZoomResetCommand}" Padding="4,7" MinWidth="44" Foreground="{DynamicResource TextMuted}"
                                FontWeight="Normal" AutomationProperties.Name="Reset tile size">
                            <TextBlock Text="{Binding CardScaleText}" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource LinkButton}" Command="{Binding ZoomInCommand}" Padding="10,7" Foreground="{DynamicResource Text}" AutomationProperties.Name="Larger tiles">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource SubtleButton}" Command="{Binding RefreshCommand}" ToolTip="Refresh all vendors now (F5)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,1,8,0" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"> <!-- spins while refreshing -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                            <DataTrigger.EnterActions><BeginStoryboard x:Name="Spin"><Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9"/>
                                            </Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="Spin"/></DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding RefreshButtonText}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SettingsButton" Style="{StaticResource SubtleButton}" Command="{Binding OpenSettingsCommand}" Margin="8,0,0,0" Padding="10,7"
                        ToolTip="Settings" AutomationProperties.Name="Settings">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="15"/>
                </Button>
            </StackPanel>
            </DockPanel>
        </Grid>

        <!-- Warning banner (unreadable config, failed save) -->
        <Border Grid.Row="1" Margin="24,10,24,0" Padding="14,10" CornerRadius="9" Background="{DynamicResource Status.Degraded.Soft}"
                Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Dismiss" Command="{Binding DismissBannerCommand}" Margin="12,0,0,0"/>
                <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" Foreground="{DynamicResource Status.Degraded}"/>
            </DockPanel>
        </Border>

        <!-- Dashboard | splitter | details panel -->
        <Grid x:Name="ContentGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MainCol" Width="*"/>
                <ColumnDefinition x:Name="SplitCol" Width="0"/>
                <ColumnDefinition x:Name="PanelCol" Width="0"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="24,14,24,8">
                <StackPanel x:Name="ScrollContent">
                    <!-- Drawn above the tiles: in TV mode its counters and ticker stick to the top and the tiles pass beneath (MainWindow.UpdateSticky) -->
                    <v:StatusBar x:Name="StatusBar" Panel.ZIndex="1"/>
                    <TextBlock Text="No vendors are enabled. Open Settings (gear icon) to pick some or add your own." Style="{StaticResource Muted}" FontSize="14"
                               Visibility="{Binding HasNoVendors, Converter={StaticResource BoolToVis}}"/>
                    <!-- Tiles: widths computed from the available width (MainViewModel.UpdateLayout), drawn at TileScale -->
                    <!-- Tiles or list; your groups (if any) as headed sections above "Other vendors". Read-only in TV mode. -->
                    <ItemsControl x:Name="CardsHost" ItemsSource="{Binding CardsView}" Margin="0,0,-14,0" Focusable="False"
                                  IsHitTestVisible="{Binding IsTvMode, Converter={StaticResource InvBool}}">
                        <ItemsControl.LayoutTransform><ScaleTransform ScaleX="{Binding TileScale}" ScaleY="{Binding TileScale}"/></ItemsControl.LayoutTransform>
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="ItemTemplate" Value="{StaticResource VendorCard}"/>
                                <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value></Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsListView}" Value="True">
                                        <Setter Property="ItemTemplate" Value="{StaticResource VendorRow}"/>
                                        <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></Setter.Value></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <!-- Explicit container: header, then the section's tiles across the full width -->
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <DockPanel>
                                                        <!-- Name (trimmed if very long) then a count badge -->
                                                        <Grid DockPanel.Dock="Top" Margin="2,4,14,10" HorizontalAlignment="Left">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name.Title}" FontFamily="{DynamicResource DisplayFont}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name.Title}"/>
                                                            <Border Grid.Column="1" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="9" Padding="7,0,7,1"
                                                                    Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ItemCount}" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
                                                            </Border>
                                                        </Grid>
                                                        <ItemsPresenter/>
                                                    </DockPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="8" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Background="Transparent" Cursor="SizeWE" Focusable="True" DragCompleted="Splitter_DragCompleted" ToolTip="Drag to resize"
                          AutomationProperties.Name="Resize details panel">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border x:Name="Grip" Width="4" Height="40" CornerRadius="2" Background="{DynamicResource Stroke}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <Border x:Name="DetailsPanel" Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1,1,0,0"
                    CornerRadius="12,0,0,0" Margin="0,14,0,0" DataContext="{Binding Selected}" Visibility="Collapsed">
                <v:DetailsView/>
            </Border>
        </Grid>

        <!-- Settings drawer: modal (Tab cycles inside it; scrim click or Esc cancels) -->
        <Grid Grid.RowSpan="3" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
            <Rectangle x:Name="SettingsScrim" Fill="{DynamicResource Scrim}" MouseLeftButtonDown="Scrim_Click"/>
            <Border x:Name="Drawer" HorizontalAlignment="Right" Width="480" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}"
                    BorderThickness="1,0,0,0" DataContext="{Binding Settings}" KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained">
                <v:SettingsView x:Name="SettingsView"/>
            </Border>
        </Grid>

        <!-- Vendors drawer: modal, like Settings -->
        <Grid Grid.RowSpan="3" Visibility="{Binding IsVendorsOpen, Converter={StaticResource BoolToVis}}">
            <Rectangle x:Name="VendorsScrim" Fill="{DynamicResource Scrim}" MouseLeftButtonDown="Scrim_Click"/>
            <Border x:Name="VendorsDrawer" HorizontalAlignment="Right" Width="580" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}"
                    BorderThickness="1,0,0,0" DataContext="{Binding Vendors}" KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained">
                <v:VendorsView x:Name="VendorsView"/>
            </Border>
        </Grid>

        <!-- First-time setup / New profile: a centred card over the (empty or current) board -->
        <Grid Grid.RowSpan="3" Visibility="{Binding IsSetupOpen, Converter={StaticResource BoolToVis}}" KeyboardNavigation.TabNavigation="Cycle">
            <Rectangle Fill="{DynamicResource Bg}" Opacity="0.96"/>
            <Border x:Name="SetupCard" MaxWidth="820" Margin="24" CornerRadius="16" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                    DataContext="{Binding Setup}" KeyboardNavigation.TabNavigation="Cycle">
                <v:SetupView x:Name="SetupView"/>
            </Border>
        </Grid>
    </Grid>
</Window>
